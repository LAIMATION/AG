# Konto Gmail używane wyłącznie do wysyłki formularza (SMTP, hasło aplikacji)
GMAIL_USER=konto-do-wysylki@gmail.com
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx

# Adres, na który trafiają zapytania z formularza
CONTACT_TO=atriumkontakt@gmail.com

# Cloudflare Turnstile (opcjonalnie, ochrona przed spamem). Oba klucze z panelu
# Cloudflare → Turnstile. Bez nich formularz działa, tylko bez tej warstwy.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
